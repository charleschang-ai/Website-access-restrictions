<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_access_control" model="res.groups.privilege">
        <field name="name">Website Access Control</field>
        <field name="sequence">24</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <record id="group_access_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_access_control"/>
        <field name="comment">Can open the Access Control menus of the Website app and change the settings, rules and logs.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="implied_by_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>

</odoo>
