<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Standalone on purpose: no website layout, so nothing of the site leaks to blocked visitors. -->
    <template id="blocked_page" name="Website Access Control: Block Page">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex"/>
                <title t-esc="title"/>
                <style>
                    body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
                           background: #f5f6f8; color: #333;
                           font-family: -apple-system, "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif; }
                    .box { text-align: center; padding: 24px; max-width: 560px; }
                    h1 { font-size: 24px; font-weight: 600; margin: 0 0 12px; }
                    p { margin: 0; color: #666; line-height: 1.7; white-space: pre-line; }
                </style>
            </head>
            <body>
                <div class="box">
                    <h1 t-esc="title"/>
                    <p t-esc="message"/>
                </div>
            </body>
        </html>
    </template>

</odoo>
